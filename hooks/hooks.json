{
  "description": "Block Slack sends that the people file doesn't allow (lloping-llama message-drafts); profile-gate: applies the repository profiles of the overlay's profiles.yaml to gh and git commands (opt-in via LLOPING_LLAMA_PROFILES)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__slack_(send|schedule)_message$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/slack_send_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/profile-gate\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
