{
  "description": "Block Slack sends that the people file doesn't allow (lloping-llama message-drafts)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__slack_(send|schedule)_message$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/slack_send_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
