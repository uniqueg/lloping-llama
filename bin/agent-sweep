#!/usr/bin/env python3
"""Entry point of the ``agent-sweep`` command (Python 3.12+, stdlib only)."""

import os
import sys

if sys.version_info < (3, 12):
    sys.exit("agent-sweep: Python 3.12 or later required")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "sweeper"))

from agent_sweeper.sweep import main  # noqa: E402

sys.exit(main())
